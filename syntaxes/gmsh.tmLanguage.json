{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gmsh",
  "scopeName": "source.gmsh",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#primitives"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gmsh",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gmsh",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.gmsh",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gmsh",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gmsh",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gmsh",
          "match": "\\b(If|ElseIf|Else|EndIf|For|EndFor|In|Return|Function|EndFunction|Include|Macro|Return|Call)\\b"
        },
        {
          "name": "keyword.other.gmsh",
          "match": "\\b(SetFactory|Physical|Mesh|Coherence|Delete|Printf|Sprintf|Error|Warning|Exit)\\b"
        }
      ]
    },
    "primitives": {
      "patterns": [
        {
          "name": "entity.name.function.gmsh",
          "match": "\\b(Point|Line|Circle|Ellipse|Spline|BSpline|Bezier|Compound|Curve|Curve\\s+Loop|Line\\s+Loop|Plane\\s+Surface|Surface|Surface\\s+Loop|Volume|Extrude|Translate|Rotate|Scale|Symmetry|Dilate|Box|Cylinder|Sphere|Torus|Cone|Wedge|BooleanIntersection|BooleanUnion|BooleanDifference|BooleanFragments)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.gmsh",
          "match": "\\b(Pi|Mesh\\.Algorithm|Mesh\\.ElementOrder|Mesh\\.CharacteristicLengthMin|Mesh\\.CharacteristicLengthMax)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gmsh",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\^|\\=|\\=\\=|\\!\\=|\\<|\\>|\\<\\=|\\>\\=|\\&\\&|\\|\\|)"
        }
      ]
    }
  }
}
